---
import PageLayout from "../../layouts/PageLayout.astro";
import { extractedHtml, swissProfile } from "../../lib/chContent";
import { localePaths, type Locale } from "../../lib/i18n";

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const body = swissProfile ? extractedHtml(locale, "todo") : "";
---

{swissProfile && <PageLayout locale={locale}><Fragment set:html={body} /></PageLayout>}
