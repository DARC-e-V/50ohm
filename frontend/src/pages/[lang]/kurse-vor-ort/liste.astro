---
// Port of packages/ohm-builder/src/ohm_builder/templates/html/kurse-liste.html, wrapped by
// `_build_page(result)`. The template consumes no snippets — it is static markup.
import PageLayout from "../../../layouts/PageLayout.astro";
import { COURSES_MAP_URL, homeUrl, LEARN_URL } from "../../../lib/urls";
import { extractedHtml, swissProfile } from "../../../lib/chContent";
import { localePaths, type Locale } from "../../../lib/i18n";
export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const swissBody = swissProfile ? extractedHtml(locale, "kurse-liste") : "";
---

<PageLayout locale={locale}>
{swissProfile ? <Fragment set:html={swissBody} /> : <Fragment>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href={homeUrl(locale)}>Home</a></li>
    <li class="breadcrumb-item"><a href={LEARN_URL(locale)}>Lernen</a></li>
    <li class="breadcrumb-item active" aria-current="page">Kurse vor Ort</li>
  </ol>
</nav>

<h1>Kurse vor Ort</h1>
<p>Erfahrene Ausbilder halten &ndash; meist einmal in der Woche abends &ndash; Lektionen. Zwischen den Treffen solltest du selbständig den Lernstoff vertiefen und üben.</p>


<a class="btn btn-outline-secondary btn-sm px-4 gap-3" href={COURSES_MAP_URL(locale)}>Kartenansicht</a>

<hr class="col-md-12 mb-3">

<script src="https://darc.de/fileadmin/config/Resources/Public/JavaScript/tx_t3jquery/jquery-1.8.x-1.9.x-1.2.x.js?1619439474" type="text/javascript"></script>
<script id="onlinekurse" type="text/javascript" src="https://ajw.darc.de/lehrgangskarte/onlinelehrgaenge.js"></script>

</Fragment>}
</PageLayout>
