---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES } from "../lib/i18n";
---

<main class="container py-5">
  <h1>50Ω</h1>
  <nav aria-label="Choose language" class="d-flex gap-3">
    {LOCALES.map((locale) => <a class="btn btn-primary" href={getRelativeLocaleUrl(locale, "")}>{locale.toUpperCase()}</a>)}
  </nav>
</main>
