---
import { getCollection } from "astro:content";
import SectionPage from "virtual:ohm/page-components/SectionPage";

import { getChapters, getEdition, getNextChapter, getNextSection } from "../../../lib/course";

export async function getStaticPaths() {
  const sections = await getCollection("sections");
  return sections.map((section) => ({
    params: {
      edition: section.data.edition,
      chapter: section.data.chapterIdent,
      section: section.data.ident,
    },
    props: { section },
  }));
}

const { section } = Astro.props;
const { edition, chapterIdent } = section.data;

const editionEntry = await getEdition(edition);

const chapters = await getChapters(edition);
const chapter = chapters.find((candidate) => candidate.data.ident === chapterIdent);

const nextSection = await getNextSection(section);
const nextChapter = chapter ? await getNextChapter(chapter) : null;
---

<SectionPage
  section={section}
  edition={editionEntry}
  chapter={chapter}
  nextSection={nextSection}
  nextChapter={nextChapter}
/>
