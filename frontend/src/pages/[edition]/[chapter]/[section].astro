---
import { getCollection } from "astro:content";
import SectionPage from "virtual:ohm/page-components/SectionPage";

import { sectionRouteData } from "../../../lib/route-data";
import { setRouteData } from "../../../locals";

export async function getStaticPaths() {
  const sections = await getCollection("sections");
  return sections.map((section) => ({
    params: {
      edition: section.data.edition,
      chapter: section.data.chapterIdent,
      section: section.data.ident,
    },
    props: { section },
  }));
}

const { section } = Astro.props;

setRouteData(Astro.locals, await sectionRouteData(section));
---

<SectionPage />
