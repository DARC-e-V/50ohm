---
import { getCollection } from "astro:content";
import ChapterPage from "virtual:ohm/page-components/ChapterPage";

import { getEdition, getNextChapter, getSections } from "../../../lib/course";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((chapter) => ({
    params: { edition: chapter.data.edition, chapter: chapter.data.ident },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { edition, ident } = chapter.data;

const editionEntry = await getEdition(edition);
const sections = await getSections(edition, ident);
const nextChapter = await getNextChapter(chapter);
---

<ChapterPage chapter={chapter} edition={editionEntry} sections={sections} nextChapter={nextChapter} />
