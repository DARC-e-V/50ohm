---
import { getCollection } from "astro:content";
import ChapterPage from "virtual:ohm/page-components/ChapterPage";

import { chapterRouteData } from "../../../lib/route-data";
import { setRouteData } from "../../../locals";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((chapter) => ({
    params: { edition: chapter.data.edition, chapter: chapter.data.ident },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;

setRouteData(Astro.locals, await chapterRouteData(chapter));
---

<ChapterPage />
