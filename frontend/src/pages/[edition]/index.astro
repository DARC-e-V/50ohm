---
import { getCollection } from "astro:content";
import EditionPage from "virtual:ohm/page-components/EditionPage";

import { getChapters } from "../../lib/course";

export async function getStaticPaths() {
  const editions = await getCollection("editions");
  return editions.map((edition) => ({
    params: { edition: edition.data.edition },
    props: { edition },
  }));
}

const { edition } = Astro.props;

const chapters = await getChapters(edition.data.edition);
---

<EditionPage edition={edition} chapters={chapters} />
