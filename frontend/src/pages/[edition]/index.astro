---
import { getCollection } from "astro:content";
import EditionPage from "virtual:ohm/page-components/EditionPage";

import { editionRouteData } from "../../lib/route-data";
import { setRouteData } from "../../locals";

export async function getStaticPaths() {
  const editions = await getCollection("editions");
  return editions.map((edition) => ({
    params: { edition: edition.data.edition },
    props: { edition },
  }));
}

const { edition } = Astro.props;

setRouteData(Astro.locals, await editionRouteData(edition));
---

<EditionPage />
