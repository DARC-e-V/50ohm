---
// Patenkarte, a DARC / AJW service to find a mentor.
// TODO: Custom page, not part of 50ohm core content, should be moved.
import Breadcrumbs from "virtual:ohm/site/Breadcrumbs";

import OhmPage from "../site/OhmPage.astro";
import { LEARN_URL } from "../lib/urls";
---

<OhmPage title="Ausbildungspaten" parents={[{ label: "Lernen", url: LEARN_URL }]}>
  <Breadcrumbs />

  <div class="row flex-lg-row-reverse align-items-top g-5 py-1">
    <div class="col-lg-7">
      <iframe src="https://ajw.darc.de/patenkarte/" width="100%" height="800px"></iframe>
    </div>

    <div class="col-lg-5">
      <h1>Ausbildungspaten</h1>
      <p>Die DARC-Ausbildungspaten sind erfahrene Funkamateure und helfen dir gerne beim Einstieg in den Amateurfunk. Sie beantworten Fragen, Helfen beim Lernen und können mit dir praktischen Ausbildungsfunk machen.</p>
    </div>
  </div>
</OhmPage>
