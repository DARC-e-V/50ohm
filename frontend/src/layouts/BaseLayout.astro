---
// The document shell, copied from
// packages/ohm-builder/src/ohm_builder/templates/html/page.html (lines 1-37, 168-171).
//
// The assets come from public/assets/, a 1:1 copy of ohm_builder/assets/, so every script tag
// is `is:inline`: they are classic scripts, and the copied markup calls into their globals
// (`toggleNavBar()` and `highlightRef()` from below).
import SiteHeader from "../components/SiteHeader.astro";
import SwissHeader from "../components/SwissHeader.astro";
import { siteLabel, swissProfile } from "../lib/chContent";
---

<!doctype html>
<html lang={siteLabel("html_lang", "de")}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{siteLabel("page_title", "50Ω Lernplattform für Amateurfunk")}</title>

    <link rel="icon" href="/assets/favicon/icon.png" type="image/png">
    <link rel="icon" href="/assets/favicon/icon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="/assets/favicon/mask-icon.svg" color="#00ADEF">
    <link href="/assets/bootstrap-5.2.0-beta1-dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/style-fiftyohm.css?ts=202312172012">
    <link rel="stylesheet" href="/assets/style-course.css?ts=202312172012">
    {swissProfile && <link rel="stylesheet" href="/assets/ch-release.css">}
    <link rel="stylesheet" href="/assets/katex/katex.min.css">
    <script is:inline defer src="/assets/katex/katex.min.js"></script>
    <script is:inline defer src="/assets/katex/auto-render.min.js"></script>
    <script is:inline defer src="/assets/latex.js"></script>
    <script is:inline defer src="/assets/script.js"></script>

    <script is:inline>
      function toggleNavBar() {
        document.getElementById("nav-dropdown").classList.toggle("open");
        document.getElementById("nav-button-closed").classList.toggle("hidden");
        document.getElementById("nav-button-opened").classList.toggle("hidden");
      }
      function highlightRef(ref) {
        console.log(ref)
        document.getElementById('ref_' + ref).style.background='#2aa6da';
        setTimeout(() => {
          document.getElementById('ref_' + ref).style.background='none';
        }, 500);
      }
    </script>
  </head>
  <body>

    {swissProfile ? <SwissHeader /> : <SiteHeader />}

    <slot />

    <script is:inline src="/assets/bootstrap-5.2.0-beta1-dist/js/bootstrap.bundle.min.js"></script>
    {swissProfile && <script is:inline src="/assets/ch-release.js"></script>}
  </body>
</html>
