---
// Inner layout for most pages with an optional sidebar.
import BaseLayout from "virtual:ohm/site/BaseLayout";
import SiteFooter from "virtual:ohm/site/SiteFooter";

const hasSidebar = Astro.slots.has("sidebar");
---

<BaseLayout>
  <div class="fiftyohm-layout-outer fiftyohm-layout-outer-content">
    <div class="fiftyohm-layout-inner">
      <div class="fiftyohm-layout-left">
      </div>
      <div class="fiftyohm-layout-main">
        <div class="fiftyohm-content w-100">
          {
            hasSidebar ?
              <div class="fiftyohm-content-2cols">
                <div><slot /></div>
                <div><slot name="sidebar" /></div>
              </div>
            : <slot />
          }

          <SiteFooter />

        </div>

        {/* Nested inside `layout-main` in page.html, so the flex widths stay identical. */}
        <div class="fiftyohm-layout-right">
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
