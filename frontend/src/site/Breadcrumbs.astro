---
// Show a trail of links, describing the current page location in the site hierarchy.
const { breadcrumbs } = Astro.locals.ohmRoute;
---

{
  breadcrumbs.length > 0 && (
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        {breadcrumbs.map(({ label, url: href }) =>
          // Last entry is the only entry without href and can safely be treated as current page.
          href ?
            <li class="breadcrumb-item"><a href={href}>{label}</a></li>
          : <li class="breadcrumb-item active" aria-current="page">{label}</li>,
        )}
      </ol>
    </nav>
  )
}
