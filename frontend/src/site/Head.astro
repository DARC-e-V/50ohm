---
// Bundled CSS lands at the end of <head>, after the remaining <link> tags below.
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/fiftyohm.css";
import "../styles/course.css";

// TODO: Read the site title from `virtual:ohm/config` once it exists.
const SITE_TITLE = "50Ω Lernplattform für Amateurfunk";

const { title } = Astro.locals.ohmRoute;
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} – ${SITE_TITLE}` : SITE_TITLE}</title>

<link rel="icon" href="/assets/favicon/icon.png" type="image/png">
<link rel="icon" href="/assets/favicon/icon.svg" type="image/svg+xml">
<link rel="mask-icon" href="/assets/favicon/mask-icon.svg" color="#00ADEF">
{/* TODO: Replace current static assets and scripts with updated variants using the available features from astro */}
<link rel="stylesheet" href="/assets/katex/katex.min.css">
<script is:inline defer src="/assets/katex/katex.min.js"></script>
<script is:inline defer src="/assets/katex/auto-render.min.js"></script>
<script is:inline defer src="/assets/latex.js"></script>
<script is:inline defer src="/assets/script.js"></script>

<script>
  import "bootstrap";
</script>
