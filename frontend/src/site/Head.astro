---
// The order is the cascade: our own styles override Bootstrap and KaTeX.
import "bootstrap/dist/css/bootstrap.min.css";
import "katex/dist/katex.min.css";
import "../styles/fiftyohm.css";
import "../styles/course.css";

// TODO: Read the site title from `virtual:ohm/config` once it exists.
const SITE_TITLE = "50Ω Lernplattform für Amateurfunk";

const { title } = Astro.locals.ohmRoute;
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} – ${SITE_TITLE}` : SITE_TITLE}</title>

{/* TODO: Moves once the 50ohm website is separated from the template. */}
<link rel="icon" href="/assets/favicon/icon.png" type="image/png">
<link rel="icon" href="/assets/favicon/icon.svg" type="image/svg+xml">
<link rel="mask-icon" href="/assets/favicon/mask-icon.svg" color="#00ADEF">

<script>
  import "bootstrap";
  import "../scripts/latex";
</script>
