---
import { INFO_URL } from "../lib/urls";
---

{/*
  Copied from packages/ohm-builder/src/ohm_builder/templates/html/page.html (lines 129-158).
  One change: the stray `</span>` after the heart SVG is gone — it had no opening tag, browsers
  dropped it, and the Astro compiler rejects it.
*/}
            <footer class="text-lg-start border-top border-dark mt-5 pt-3">
              <div class="d-flex flex-wrap align-items-end justify-content-between gap-5 mb-5">
                <div>
                  <img height="90" src="/assets/images/darc.svg">
                </div>
                <div class="d-flex flex-column align-items-center">
                  <div class="d-flex gap-1 align-items-center mb-1">
                    Mit
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" fill="#FE756C" viewBox="0 0 512 512"><path d="M47.6 300.4L228.3 469.1c7.5 7 17.4 10.9 27.7 10.9s20.2-3.9 27.7-10.9L464.4 300.4c30.4-28.3 47.6-68 47.6-109.5v-5.8c0-69.9-50.5-129.5-119.4-141C347 36.5 300.6 51.4 268 84L256 96 244 84c-32.6-32.6-79-47.5-124.6-39.9C50.5 55.6 0 115.2 0 185.1v5.8c0 41.5 17.2 81.2 47.6 109.5z"/></svg>
