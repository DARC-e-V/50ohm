                  </div>
                  <div class="mb-1">Ein Angebot des Deutschen Amateur-Radio-Clubs e.&nbsp;V.</div>
                  <div class="d-flex gap-2">
                      <a class="link-secondary" href="https://www.darc.de/der-club/referate/ajw/">Referat AJW</a>
                      &middot;
                      <a class="link-secondary" href="https://darc.de/impressum">Impressum</a>
                      &middot;
                      <a class="link-secondary" href="https://darc.de/datenschutzerklaerung">Datenschutz</a>
                  </div>
                </div>
                <div class="text-start">
                  <div>Unterstützt von:</div>
                  <div style="margin-top: -15px;">
                    <a href="https://www.rohde-schwarz.com/ausbildung">
                      <img style="width: 300px;" src="/assets/images/rus-logo-gross.svg">
                    </a>
                  </div>
                </div>
              </div>
            </footer>
