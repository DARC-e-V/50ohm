---
// `<Tag type="margin|tip|indepth|attention|danger|unit|wordorigin|person|warning|…">`.
// Port of ohm_renderer/templates/margin.html.
//
// Two deliberate differences from that template, because the MDX only carries `type`:
//   * no `id="margin_for_<n>"` / `id="margin_orig_<n>"` — nothing (CSS or content) references
//     those ids, and the renderer does not emit the counters they were built from.
//   * the per-box inline <script> is replaced by src/scripts/margin.ts, bundled once per page,
//     which pairs each box with the `<a class="margin-origin">` right behind it and with the
//     nearest preceding `<a id="margin_N">` anchor.
interface Props {
  type: string;
}

const { type } = Astro.props;
---

<div class={`margin ${type}`}>
  <slot />
</div>
<a class="margin-origin"></a>

<script>
  import "../scripts/margin";
</script>
