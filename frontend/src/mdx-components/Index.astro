---
// `<Index first="…" second="…" />`.
// Port of `render_index` in ohm_renderer/fifty_ohm_html_renderer.py:257. The MDX carries only the
// terms, so the anchor id is derived here — with the same rules the search index uses.
import { indexAnchorId } from "../lib/indexAnchorId";

interface Props {
  first: string;
  second?: string;
}

const { first, second } = Astro.props;
---

<span id={indexAnchorId(first, second)} class="index-anchor" aria-hidden="true"></span>
