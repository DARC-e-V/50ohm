---
// Renders the MDX content of the current edition, chapter or section.
import { render } from "astro:content";
import mdxComponents from "virtual:ohm/mdx-components";

const course = Astro.locals.ohmCourse;
const entry =
  course.kind === "edition" ? course.edition
  : course.kind === "chapter" ? course.chapter
  : course.section;

const { Content } = await render(entry);
---

<div class="course">
  {/* Fallback anchor for margin boxes without a `---` above. */}
  <a id="margin_0"></a>
  <Content components={mdxComponents} />
</div>
